<Window x:Class="Steamedpass.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Steamedpass.App"
        mc:Ignorable="d"
        Title="steamedpass" Height="600" Width="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Installed Game Pass apps" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />

        <ListView x:Name="GamesList" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="240" />
                    <GridViewColumn Header="Executable" DisplayMemberBinding="{Binding Executable}" Width="180" />
                    <GridViewColumn Header="AUMID" DisplayMemberBinding="{Binding Aumid}" Width="300" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" Padding="10,4" Margin="0,0,8,0" Click="RefreshButton_Click" />
            <Button x:Name="AddButton" Content="Add to Steam" Padding="10,4" Margin="0,0,8,0" Click="AddButton_Click" />
            <Button x:Name="SettingsButton" Content="Settings" Padding="10,4" Click="SettingsButton_Click" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
