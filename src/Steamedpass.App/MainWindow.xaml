<ui:FluentWindow x:Class="Steamedpass.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Steamedpass.App"
        mc:Ignorable="d"
        Title="SteamedPass" Height="640" Width="820"
        MinHeight="480" MinWidth="640"
        Icon="Resources/SteamedPass.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="GamesGridHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="4,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid x:Name="HeaderRoot">
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource AccentButtonBackground}"
                                    BorderThickness="0,0,0,2">
                                <Border Margin="6,0,0,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        RecognizesAccessKey="True" />
                                </Border>
                            </Border>
                            <Canvas>
                                <Thumb Name="PART_HeaderGripper">
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="Canvas.Right" Value="-9" />
                                            <Setter Property="Width" Value="18" />
                                            <Setter Property="Height" Value="{Binding Path=ActualHeight, ElementName=HeaderRoot}" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Padding="{TemplateBinding Padding}" Background="#00FFFFFF">
                                                            <Rectangle Width="1" HorizontalAlignment="Center" Fill="{TemplateBinding Background}" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Canvas>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Title="SteamedPass" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Resources/SteamedPass.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20,8,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TextBlock Grid.Row="0" Text="List of installed UWP apps" FontTypography="BodyStrong" Margin="0,0,0,8" />

            <ProgressBar x:Name="RefreshProgressBar" Grid.Row="1" IsIndeterminate="True" Height="3"
                         BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource AccentButtonBackground}"
                         Margin="0,0,0,8" Visibility="Collapsed" />

            <Grid Grid.Row="2">
                <ui:Card Padding="0">
                    <ui:ListView x:Name="GamesList" BorderThickness="0" Background="Transparent">
                        <ui:ListView.View>
                            <ui:GridView ColumnHeaderContainerStyle="{StaticResource GamesGridHeaderStyle}">
                                <GridViewColumn x:Name="SelectColumn" Width="60">
                                    <GridViewColumn.Header>
                                        <CheckBox x:Name="SelectAllCheckBox" Click="SelectAllCheckBox_Click" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="AddedColumn" Header="Added" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True"
                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}}"
                                                           ToolTip="Already added to Steam" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="IconColumn" Header="Icon" Width="48">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding IconPath}" Width="28" Height="28"
                                                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="NameColumn" Header="Name" DisplayMemberBinding="{Binding Name}" Width="240" />
                                <GridViewColumn x:Name="ExecutableColumn" Header="Executable" DisplayMemberBinding="{Binding Executable}" Width="200" />
                                <GridViewColumn x:Name="AumidColumn" Header="AUMID" DisplayMemberBinding="{Binding Aumid}" Width="260" />
                            </ui:GridView>
                        </ui:ListView.View>
                    </ui:ListView>
                </ui:Card>

                <Border x:Name="LoadingOverlay" Background="{DynamicResource ApplicationBackgroundBrush}"
                        CornerRadius="4" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32" Margin="0,0,0,12" />
                        <TextBlock Text="Scanning installed apps..." HorizontalAlignment="Center" Opacity="0.8" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                <ui:Button x:Name="RefreshButton" Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,8,0" Click="RefreshButton_Click" />
                <ui:Button x:Name="AddButton" Content="Add Selected to Steam" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="0,0,8,0" Click="AddButton_Click" />
                <ui:Button x:Name="SettingsButton" Content="Settings" Icon="{ui:SymbolIcon Settings24}" Click="SettingsButton_Click" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.8" />
        </Grid>
    </Grid>
</ui:FluentWindow>
