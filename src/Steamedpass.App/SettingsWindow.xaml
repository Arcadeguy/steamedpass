<ui:FluentWindow x:Class="Steamedpass.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="steamedpass settings" Height="680" Width="540"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="steamedpass settings" Grid.Row="0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,20">
            <StackPanel>

                <ui:TextBlock Text="Desktop Shortcut" FontTypography="BodyStrong" Margin="0,0,0,4" />
                <CheckBox x:Name="CreateDesktopShortcutCheck" Content="Create a desktop shortcut when adding a game to Steam" Margin="0,0,0,12" />

                <ui:TextBlock Text="Language" FontTypography="BodyStrong" Margin="0,0,0,4" />
                <CheckBox x:Name="ChangeLanguageCheck" Content="Override the game's UI language" Margin="0,0,0,4" />
                <ComboBox x:Name="LanguageCombo" Margin="0,0,0,12" />

                <ui:TextBlock Text="Timing" FontTypography="BodyStrong" Margin="0,0,0,4" />
                <TextBlock Text="Seconds between checks of whether the game is still running:" Margin="0,0,0,4" />
                <ComboBox x:Name="SecondsCombo" Margin="0,0,0,12" />

                <CheckBox x:Name="StreamModeCheck" Content="Stream mode (show a full-screen cover window for ~10s before launching)" Margin="0,0,0,12" />

                <ui:TextBlock Text="Resolution" FontTypography="BodyStrong" Margin="0,0,0,4" />
                <CheckBox x:Name="ChangeResolutionCheck" Content="Change display resolution before launching" Margin="0,0,0,4" />
                <ComboBox x:Name="ResolutionCombo" Margin="0,0,0,12" />

                <ui:TextBlock Text="Logging" FontTypography="BodyStrong" Margin="0,0,0,4" />
                <ComboBox x:Name="LogLevelCombo" Margin="0,0,0,12">
                    <ComboBoxItem Content="Error" />
                    <ComboBoxItem Content="Debug" />
                    <ComboBoxItem Content="Trace" />
                </ComboBox>

                <ui:TextBlock Text="SteamGridDB (Library grid art)" FontTypography="BodyStrong" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,4">
                    <ui:Button DockPanel.Dock="Right" Content="Get key" Margin="8,0,0,0" Click="GetApiKeyButton_Click" />
                    <ui:PasswordBox x:Name="ApiKeyBox" PlaceholderText="SteamGridDB API key" />
                </DockPanel>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                        <TextBlock Text="Style" />
                        <ComboBox x:Name="StyleCombo" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                        <TextBlock Text="Type" />
                        <ComboBox x:Name="TypeCombo" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="NSFW" />
                        <ComboBox x:Name="NsfwCombo" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Humor" />
                        <ComboBox x:Name="HumorCombo" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Steam category tags (comma-separated)" Margin="0,8,0,4" />
                <ui:TextBox x:Name="TagsBox" Margin="0,0,0,12" />

                <ui:TextBlock Text="Maintenance" FontTypography="BodyStrong" Margin="0,0,0,4" />
                <ui:Button x:Name="ClearAllButton" Content="Clear all non-Steam shortcuts..." Appearance="Danger"
                           Icon="{ui:SymbolIcon Delete24}" HorizontalAlignment="Left" Click="ClearAllButton_Click" Margin="0,0,0,16" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" Margin="0,0,8,0" Click="CancelButton_Click" />
                    <ui:Button Content="Save" Appearance="Primary" Click="SaveButton_Click" IsDefault="True" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
