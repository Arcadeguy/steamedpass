<Window x:Class="Steamedpass.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="steamedpass settings" Height="640" Width="520"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <TextBlock Text="Language" FontWeight="Bold" Margin="0,0,0,4" />
            <CheckBox x:Name="ChangeLanguageCheck" Content="Override the game's UI language" Margin="0,0,0,4" />
            <ComboBox x:Name="LanguageCombo" Margin="0,0,0,12" />

            <TextBlock Text="Timing" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Seconds between checks of whether the game is still running:" Margin="0,0,0,4" />
            <ComboBox x:Name="SecondsCombo" Margin="0,0,0,12" />

            <CheckBox x:Name="StreamModeCheck" Content="Stream mode (show a full-screen cover window for ~10s before launching)" Margin="0,0,0,12" />

            <TextBlock Text="Resolution" FontWeight="Bold" Margin="0,0,0,4" />
            <CheckBox x:Name="ChangeResolutionCheck" Content="Change display resolution before launching" Margin="0,0,0,4" />
            <ComboBox x:Name="ResolutionCombo" Margin="0,0,0,12" />

            <TextBlock Text="Logging" FontWeight="Bold" Margin="0,0,0,4" />
            <ComboBox x:Name="LogLevelCombo" Margin="0,0,0,12">
                <ComboBoxItem Content="Error" />
                <ComboBoxItem Content="Debug" />
                <ComboBoxItem Content="Trace" />
            </ComboBox>

            <TextBlock Text="SteamGridDB (Library grid art)" FontWeight="Bold" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Get key" Padding="8,2" Click="GetApiKeyButton_Click" />
                <PasswordBox x:Name="ApiKeyBox" Margin="0,0,8,0" />
            </DockPanel>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                    <TextBlock Text="Style" />
                    <ComboBox x:Name="StyleCombo" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                    <TextBlock Text="Type" />
                    <ComboBox x:Name="TypeCombo" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="NSFW" />
                    <ComboBox x:Name="NsfwCombo" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Humor" />
                    <ComboBox x:Name="HumorCombo" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Steam category tags (comma-separated)" Margin="0,8,0,4" />
            <TextBox x:Name="TagsBox" Margin="0,0,0,12" />

            <TextBlock Text="Maintenance" FontWeight="Bold" Margin="0,0,0,4" />
            <Button x:Name="ClearAllButton" Content="Clear all non-Steam shortcuts..." HorizontalAlignment="Left" Padding="8,4" Click="ClearAllButton_Click" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="12,4" Margin="0,0,8,0" Click="CancelButton_Click" />
                <Button Content="Save" Padding="12,4" Click="SaveButton_Click" IsDefault="True" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
